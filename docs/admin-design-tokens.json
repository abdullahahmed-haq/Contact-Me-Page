        "cssVariable": "--admin-line",
        "purpose": "Dividers and secondary button borders"
      },
      "accent": {
        "value": "#deebd5",
        "cssVariable": "--admin-accent",
        "purpose": "Declared sage primitive; individual components use local sage tints"
