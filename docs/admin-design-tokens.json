      },
      "nav-active-ink": {
        "value": "#324c2c",
        "cssVariable": null,
        "purpose": "Active navigation text"
      },
      "published": {
        "value": "#e5eddf",
        "cssVariable": null,
        "purpose": "Published status fill"
      },
      "published-ink": {
        "value": "#3e6536",
        "cssVariable": null,
        "purpose": "Published status text"
      },
      "draft": {
        "value": "#f9edd0",
        "cssVariable": null,
        "purpose": "Unsaved and draft status fill"
