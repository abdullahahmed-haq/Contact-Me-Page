      "arabic": "\"Noto Sans Arabic Variable\", sans-serif",
      "body": {
        "fontSize": "14px",
        "lineHeight": 1.5
      },
      "pageHeading": {
        "fontSize": "30px",
        "mobileFontSize": "25px",
        "fontWeight": 800,
        "lineHeight": 1.3,
        "letterSpacing": "-0.035em",
        "arabicLetterSpacing": "0"
      },
      "panelHeading": {
        "fontSize": "18px",
        "mobileFontSize": "17px",
        "fontWeight": 750,
        "letterSpacing": "-0.02em",
        "arabicLetterSpacing": "0"
      },
