{
  "schemaVersion": 1,
  "format": "Standalone admin design reference; not the Impeccable public live-panel sidecar schema",
  "title": "Connect Studio admin design tokens",
  "scope": {
    "routes": "/admin and /admin/login",
    "cssRoot": ".admin-app, .admin-login",
    "publicAuthority": "DESIGN.md frontmatter and .impeccable/design.json",
    "sourceOfTruth": "app/admin/admin.css; components/admin/",
    "publicTokensModified": false
  },
  "tokens": {
    "colors": {
