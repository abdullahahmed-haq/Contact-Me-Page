# Local: copy to .env.local. Production must use HTTPS and a managed PostgreSQL database.
# Local development uses persistent .data/postgres when DATABASE_URL is empty.
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 48. Required in production.
# Development generates a private ignored .data/auth-secret if this is empty.
BETTER_AUTH_SECRET=

# Optional production alternative to S3: Vercel Blob, server-side only.
# Vercel supplies OIDC credentials for BLOB_STORE_ID. Outside Vercel, use a read/write token.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Production S3-compatible persistent storage. AWS SDK uses its standard credential chain.
# Never prefix these with NEXT_PUBLIC_. Bucket objects are publicly readable images.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: a single IP header OVERWRITTEN by your trusted reverse proxy.
# Leave empty for a conservative shared authentication rate-limit bucket.
TRUSTED_IP_HEADER=

# Optional local-only paths (one running process per embedded database directory).
LOCAL_DATABASE_DIR=
LOCAL_ASSET_DIR=

# Optional initial canonical URL, used only by the first database seed.
NEXT_PUBLIC_CONNECT_URL=

# Provision/recover through the CLI only. Supply OWNER_PASSWORD temporarily in your shell,
# then unset it. Do not keep a real password in this template or production runtime.
OWNER_EMAIL=

# Maintenance retention for aggregate analytics.
ANALYTICS_RETENTION_DAYS=365
